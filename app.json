{
  "expo": {
    "name": "Archers Market",
    "slug": "archersmarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "archersmarket",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B1B1D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.archersmarket.app"
    },
    "android": {
      "package": "com.archersmarket.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B1B1D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Archers Market a besoin d'accéder à vos photos pour illustrer vos annonces."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
